%h1 Filmes

%table#movies
  %thead
    %tr
      %th= link_to "Título", movies_path(sort: "title")
      %th Classificação
      %th= link_to "Lançamento", movies_path(sort: "release_date")
      %th Ações
  %tbody
    - @movies.each do |movie|
      %tr
        %td= movie.title
        %td= movie.rating
        %td= movie.release_date&.strftime("%d/%m/%Y")
        %td= link_to "Mostrar", movie

= link_to "Novo filme", new_movie_path

%h2 Search TMDb for a movie

= form_tag search_tmdb_path, method: :post do
  = label_tag :search_terms, "Search Terms"
  = text_field_tag :search_terms
  = submit_tag "Search TMDb"